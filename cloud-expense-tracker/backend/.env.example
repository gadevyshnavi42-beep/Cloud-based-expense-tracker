PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string (replace user, password and cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense_tracker?retryWrites=true&w=majority
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000
